# Somente no servidor do Next (route handlers em app/api). Nunca use o prefixo NEXT_PUBLIC_.
BACKEND_API_URL=http://localhost:8000/v1
BACKEND_API_TOKEN=
SESSION_USER_ID=89
# O protótipo usa um único usuário para todos os visitantes. Em produção (next start / deploy)
# as rotas respondem 503 a menos que isto seja true — só ligue em demo local, nunca em deploy público.
# ALLOW_SHARED_DEMO_USER=true
