# ---- Autenticação de serviço ----
# token:usuarios  (vários separados por vírgula; usuários separados por "|"; "*" = qualquer usuário)
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_TOKENS=troque-por-um-token-forte:89

# ---- Banco (Supabase, projeto nbbucsnxhimhmmhpmxfe) ----
# Dashboard → Connect → Session pooler. Vazio = dados do protótipo em memória.
DATABASE_URL=
# DATABASE_URL=postgresql://postgres.nbbucsnxhimhmmhpmxfe:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ---- IA (qualquer API compatível com OpenAI) ----
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# OpenAI:            LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
# OpenRouter:        LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=openai/gpt-4o-mini
# DeepSeek:          LLM_BASE_URL=https://api.deepseek.com/v1      LLM_MODEL=deepseek-chat

# ---- RAG (opcional; só com DATABASE_URL). Sem chave, a base inteira vai no prompt ----
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small

WHATSAPP_NUMBER=5561999999999
# TODAY_OVERRIDE=2026-08-20   # data fixa para demonstrar o cálculo de vencimento

# ---- API ----
# API_PREFIX=/v1          # o front usa BACKEND_API_URL=http://localhost:8000/v1
