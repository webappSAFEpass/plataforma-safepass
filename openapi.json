{
  "openapi": "3.1.0",
  "info": {
    "title": "SAFEpass Backend",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/plans": {
      "get": {
        "tags": [
          "dados"
        ],
        "summary": "List Plans",
        "operationId": "list_plans_v1_plans_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Plan"
                  },
                  "type": "array",
                  "title": "Response List Plans V1 Plans Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/account/{userId}": {
      "get": {
        "tags": [
          "dados"
        ],
        "summary": "Get Account",
        "operationId": "get_account_v1_account__userId__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,9}$",
              "title": "Userid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/dependents": {
      "get": {
        "tags": [
          "dados"
        ],
        "summary": "List Dependents",
        "operationId": "list_dependents_v1_dependents_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,9}$",
              "title": "Userid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Dependent"
                  },
                  "title": "Response List Dependents V1 Dependents Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/documents": {
      "get": {
        "tags": [
          "dados"
        ],
        "summary": "List Documents",
        "operationId": "list_documents_v1_documents_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,9}$",
              "title": "Userid"
            }
          },
          {
            "name": "dependentId",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^([1-9][0-9]{0,9}|dep_[0-9]{1,10}|pet_[0-9]{1,10})$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Dependentid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DocumentItem"
                  },
                  "title": "Response List Documents V1 Documents Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/providers": {
      "get": {
        "tags": [
          "dados"
        ],
        "summary": "List Providers",
        "operationId": "list_providers_v1_providers_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "categoria",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ],
              "title": "Categoria"
            }
          },
          {
            "name": "especialidade",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ],
              "title": "Especialidade"
            }
          },
          {
            "name": "cidade",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cidade"
            }
          },
          {
            "name": "modalidade",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "presencial",
                    "online"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Modalidade"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Provider"
                  },
                  "title": "Response List Providers V1 Providers Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/leads": {
      "post": {
        "tags": [
          "assistente"
        ],
        "summary": "Create Lead",
        "operationId": "create_lead_v1_leads_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/chat": {
      "post": {
        "tags": [
          "assistente"
        ],
        "summary": "Chat",
        "operationId": "chat_v1_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/chat/stream": {
      "post": {
        "tags": [
          "assistente"
        ],
        "summary": "Chat Stream",
        "description": "SSE: `token` (pedaço de texto), `reset` (descartar o texto já recebido), `card` (Card),\n`done` (ChatResponse final — o front deve exibir `reply` dele), `error`.",
        "operationId": "chat_stream_v1_chat_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/atendimento": {
      "get": {
        "tags": [
          "assistente"
        ],
        "summary": "Get Atendimento",
        "description": "Para o front mostrar o horário sem duplicar a regra (ex.: no aviso de recado quando a IA falha).",
        "operationId": "get_atendimento_v1_atendimento_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AtendimentoInfo"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/recados": {
      "post": {
        "tags": [
          "assistente"
        ],
        "summary": "Create Recado",
        "operationId": "create_recado_v1_recados_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecadoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/consent": {
      "get": {
        "tags": [
          "assistente"
        ],
        "summary": "Get Consent",
        "operationId": "get_consent_v1_consent_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,9}$",
              "title": "Userid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentStatus"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "assistente"
        ],
        "summary": "Set Consent",
        "operationId": "set_consent_v1_consent_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentStatus"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AtendimentoInfo": {
        "properties": {
          "horario": {
            "type": "string",
            "title": "Horario"
          },
          "mensagemForaDoHorario": {
            "type": "string",
            "title": "Mensagemforadohorario"
          }
        },
        "type": "object",
        "required": [
          "horario",
          "mensagemForaDoHorario"
        ],
        "title": "AtendimentoInfo",
        "description": "Horário do atendimento humano, vindo das regras da PO (o front não guarda essa regra)."
      },
      "ChatDebug": {
        "properties": {
          "intent": {
            "type": "string",
            "enum": [
              "duvida_plataforma",
              "consulta_conta",
              "consulta_dependentes",
              "consulta_documentos",
              "busca_prestadores",
              "fallback_whatsapp",
              "conversa_geral"
            ],
            "title": "Intent"
          },
          "toolCalls": {
            "items": {
              "$ref": "#/components/schemas/ToolCallLog"
            },
            "type": "array",
            "title": "Toolcalls"
          },
          "latencyMs": {
            "type": "integer",
            "title": "Latencyms"
          }
        },
        "type": "object",
        "required": [
          "intent",
          "toolCalls",
          "latencyMs"
        ],
        "title": "ChatDebug"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "ChatRequest": {
        "properties": {
          "userId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,9}$",
            "title": "Userid"
          },
          "conversationId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "title": "Conversationid"
          },
          "lead": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Lead"
              },
              {
                "type": "null"
              }
            ]
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Messages"
          },
          "simulateAfterHours": {
            "type": "boolean",
            "title": "Simulateafterhours",
            "default": false
          },
          "simulateWithinHours": {
            "type": "boolean",
            "title": "Simulatewithinhours",
            "default": false
          },
          "retry": {
            "type": "boolean",
            "title": "Retry",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "userId",
          "conversationId",
          "messages"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "cards": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ProvidersCard"
                },
                {
                  "$ref": "#/components/schemas/DocumentsCard"
                },
                {
                  "$ref": "#/components/schemas/WhatsappCard"
                },
                {
                  "$ref": "#/components/schemas/ConsentCard"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "consent": "#/components/schemas/ConsentCard",
                  "documents": "#/components/schemas/DocumentsCard",
                  "providers": "#/components/schemas/ProvidersCard",
                  "whatsapp": "#/components/schemas/WhatsappCard"
                }
              }
            },
            "type": "array",
            "title": "Cards"
          },
          "debug": {
            "$ref": "#/components/schemas/ChatDebug"
          }
        },
        "type": "object",
        "required": [
          "reply",
          "cards",
          "debug"
        ],
        "title": "ChatResponse"
      },
      "ConsentCard": {
        "properties": {
          "type": {
            "type": "string",
            "const": "consent",
            "title": "Type",
            "default": "consent"
          },
          "data": {
            "$ref": "#/components/schemas/ConsentData"
          }
        },
        "type": "object",
        "required": [
          "type",
          "data"
        ],
        "title": "ConsentCard"
      },
      "ConsentData": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ConsentData"
      },
      "ConsentRequest": {
        "properties": {
          "userId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,9}$",
            "title": "Userid"
          },
          "action": {
            "type": "string",
            "enum": [
              "grant",
              "revoke"
            ],
            "title": "Action"
          }
        },
        "type": "object",
        "required": [
          "userId",
          "action"
        ],
        "title": "ConsentRequest"
      },
      "ConsentStatus": {
        "properties": {
          "granted": {
            "type": "boolean",
            "title": "Granted"
          },
          "grantedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grantedat"
          },
          "expiresAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expiresat"
          }
        },
        "type": "object",
        "required": [
          "granted",
          "grantedAt",
          "expiresAt"
        ],
        "title": "ConsentStatus"
      },
      "Dependent": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "nome": {
            "type": "string",
            "title": "Nome"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "pessoa",
              "pet"
            ],
            "title": "Tipo"
          },
          "dataNascimento": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Datanascimento"
          },
          "especie": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Especie"
          },
          "raca": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raca"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nome",
          "tipo",
          "dataNascimento",
          "especie",
          "raca"
        ],
        "title": "Dependent"
      },
      "DocumentItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "titularId": {
            "type": "string",
            "title": "Titularid"
          },
          "titularNome": {
            "type": "string",
            "title": "Titularnome"
          },
          "tipo": {
            "type": "string",
            "title": "Tipo"
          },
          "validade": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Validade"
          },
          "status": {
            "type": "string",
            "enum": [
              "valido",
              "vencendo",
              "vencido"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "titularId",
          "titularNome",
          "tipo",
          "validade",
          "status"
        ],
        "title": "DocumentItem"
      },
      "DocumentsCard": {
        "properties": {
          "type": {
            "type": "string",
            "const": "documents",
            "title": "Type",
            "default": "documents"
          },
          "data": {
            "items": {
              "$ref": "#/components/schemas/DocumentItem"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "type",
          "data"
        ],
        "title": "DocumentsCard"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Lead": {
        "properties": {
          "nome": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Nome"
          },
          "telefone": {
            "type": "string",
            "maxLength": 30,
            "title": "Telefone"
          }
        },
        "type": "object",
        "required": [
          "nome",
          "telefone"
        ],
        "title": "Lead"
      },
      "LeadRequest": {
        "properties": {
          "userId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,9}$",
            "title": "Userid"
          },
          "nome": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
